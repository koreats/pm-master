# PM System 2025 환경 변수 설정
# 이 파일을 복사하여 .env.local 파일을 생성하고 실제 값을 입력하세요

# Supabase 설정
# https://app.supabase.com 에서 프로젝트 생성 후 설정값 확인
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 선택적 설정 (향후 추가 예정)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_NAME="PM System 2025"